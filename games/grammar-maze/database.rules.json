{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{4,5}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{4,5}$/) && (!data.exists() && newData.child('hostId').val() == auth.uid && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 60000 && newData.child('createdAt').val() >= now - 120000 || data.exists() && data.child('hostId').val() == auth.uid && (!newData.exists() || newData.child('hostId').val() == auth.uid && data.child('createdAt').isNumber() && now - data.child('createdAt').val() < 28800000))",
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "hostId": {
          ".validate": "newData.isString() && newData.val() == auth.uid && newData.val().length > 0 && newData.val().length <= 128 && (!data.exists() || newData.val() == data.val())"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'lobby' || newData.val() == 'play' || newData.val() == 'done')"
        },
        "qIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 == 0"
        },
        "roundStart": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "timerMs": {
          ".validate": "newData.isNumber() && newData.val() >= 10000 && newData.val() <= 60000"
        },
        "settings": {
          ".validate": "newData.hasChildren(['count', 'timer', 'zone', 'topics'])",
          "count": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 20 && newData.val() % 1 == 0"
          },
          "timer": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 60 && newData.val() % 1 == 0"
          },
          "zone": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "topics": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 800"
          },
          "$other": {
            ".validate": "false"
          }
        },
        "questions": {
          ".validate": "newData.numChildren() >= 8 && newData.numChildren() <= 20",
          "$i": {
            "topic": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            },
            "prompt": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400"
            },
            "why": {
              ".validate": "newData.isString() && newData.val().length <= 400"
            },
            "correct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            },
            "choices": {
              ".validate": "newData.numChildren() >= 2 && newData.numChildren() <= 3",
              "$c": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180"
              }
            },
            "$other": {
              ".validate": "false"
            }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && $uid == auth.uid && root.child('rooms').child($code).child('createdAt').isNumber() && now - root.child('rooms').child($code).child('createdAt').val() < 28800000",
            ".validate": "newData.hasChildren(['name', 'score', 'answered']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 30000 && newData.child('answered').isNumber() && newData.child('answered').val() >= 0 && newData.child('answered').val() <= 20 && (root.child('rooms').child($code).child('hostId').val() == auth.uid || !data.exists() && newData.child('score').val() == 0 && newData.child('answered').val() == 0 || data.exists() && newData.child('name').val() == data.child('name').val() && newData.child('score').val() >= data.child('score').val() && newData.child('score').val() <= data.child('score').val() + 1500 && newData.child('answered').val() >= data.child('answered').val() && newData.child('answered').val() <= data.child('answered').val() + 1)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
            },
            "answered": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 == 0"
            },
            "lastCorrect": {
              ".validate": "newData.isBoolean()"
            },
            "lastPoints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1500"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": "false"
            }
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}
